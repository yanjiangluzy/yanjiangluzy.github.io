<section class="archive-page"><p class="eyebrow">TOPIC</p><h1># <%= page.tag || page.title %></h1><div class="post-list compact"><% page.posts.each(function(post){ %><article class="post-card"><div class="post-meta"><time><%= post.date.format('YYYY年MM月DD日') %></time></div><h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2></article><% }) %></div></section>
