<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Hexo">
  <title><%= page.title ? `${page.title} | ${config.title}` : config.title %></title>
  <% if (page.description) { %><meta name="description" content="<%= page.description %>"><% } else if (config.description) { %><meta name="description" content="<%= config.description %>"><% } %>
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
