<section class="archive-page"><p class="eyebrow">JOURNAL</p><h1>归档</h1><div class="archive-timeline"><% page.posts.each(function(post){ %><article class="timeline-item"><time datetime="<%= post.date.toISOString() %>"><%= post.date.format('YYYY.MM.DD') %></time><div><h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2><p><%= post.date.format('YYYY年MM月') %></p></div></article><% }) %></div></section>
